    {
      "sql": "WITH selected AS (\n SELECT area_fips,area_title,industry_code,annual_avg_emplvl,avg_annual_pay\n FROM annual WHERE agglvl_code='75' AND own_code='5'\n  AND industry_code IN ('621','622') AND right(area_fips,3)<>'999'\n)\nSELECT a.area_fips,a.area_title,a.annual_avg_emplvl AS ambulatory_jobs,\n       h.annual_avg_emplvl AS hospital_jobs,a.avg_annual_pay AS ambulatory_pay,\n       h.avg_annual_pay AS hospital_pay\nFROM selected a JOIN selected h ON a.area_fips=h.area_fips\nWHERE a.industry_code='621' AND h.industry_code='622'\nORDER BY a.area_fips LIMIT 20",
      "columns": [
        "area_fips",
        "area_title",
        "ambulatory_jobs",
        "hospital_jobs",
        "ambulatory_pay",
        "hospital_pay"
      ],
